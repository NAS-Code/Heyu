<?xml version="1.0" encoding="utf-8"?>
<!-- Heyu icon: an hourglass whose top and bottom are chat bubbles, tails meeting at the neck.
     108x108 adaptive-icon canvas; everything sits inside the 66dp safe circle so no launcher shape clips it.
     Text lines are holes (evenOdd) so the same drawing works as the one-color themed icon. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Hourglass frame: top and bottom bars -->
    <path android:fillColor="#FFFFFF" android:pathData="M37.5,27h33a1.5,1.5 0,0 1,0 3h-33a1.5,1.5 0,0 1,0 -3z" />
    <path android:fillColor="#FFFFFF" android:pathData="M37.5,78h33a1.5,1.5 0,0 1,0 3h-33a1.5,1.5 0,0 1,0 -3z" />
    <!-- Top bubble, tail pointing down into the neck -->
    <path
        android:fillColor="#FFFFFF"
        android:fillType="evenOdd"
        android:pathData="M44,32H64A6,6 0,0 1,70 38V42A6,6 0,0 1,64 48H59L54,54L49,48H44A6,6 0,0 1,38 42V38A6,6 0,0 1,44 32Z
            M44,36.5h20v2.5h-20z
            M44,41h13v2.5h-13z" />
    <!-- Bottom bubble, tail pointing up to meet it -->
    <path
        android:fillColor="#FFFFFF"
        android:fillType="evenOdd"
        android:pathData="M44,60H49L54,54L59,60H64A6,6 0,0 1,70 66V70A6,6 0,0 1,64 76H44A6,6 0,0 1,38 70V66A6,6 0,0 1,44 60Z
            M44,64.5h16v2.5h-16z
            M44,69h9v2.5h-9z" />
</vector>
